{
	"include": ["src/**/*"],
	"exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
	"compilerOptions": {
		"noEmit": true,
		"jsx": "preserve",
		"lib": ["esnext", "dom", "dom.iterable"],
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"target": "esnext",
		"module": "preserve",
		"moduleResolution": "bundler",
		"downlevelIteration": true,
		"types": ["node", "vite/client"],
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
